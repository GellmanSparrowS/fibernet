include LICENSE
include README.md
include PYPI_README.md
include README_CN.md
include CHANGELOG.md
include requirements.txt
include requirements-dev.txt
recursive-include fibernet *.py
recursive-include tests *.py
recursive-include examples *.py
recursive-include docs *.rst *.py *.md *.png
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
prune docs/_build
prune build
prune dist
prune *.egg-info
include examples/data/lammps_braced_network_si.json

# Source-distribution inputs for the standalone library examples and tests.
recursive-include examples/fixtures *.json
recursive-include tests/fixtures *.json *.txt *.md
include .gitattributes
include scripts/deformation_test/run_large_deformation_fem.py
# Only the project-generated procedural pyramid, with its license/provenance.
include FiberScope/assets/obj/demo_pyramid.obj
include FiberScope/LICENSE
include FiberScope/THIRD_PARTY_NOTICES.md
# Repository/desktop/benchmark integration checks remain in full-checkout CI.
exclude tests/test_pruning_matching.py
exclude tests/test_independent_fem_cycle_intervention.py
exclude tests/test_recruitment_fem_validation.py
exclude tests/test_cycle_intervention.py
exclude tests/test_ai_cycle_selector.py
exclude tests/test_constrained_cycle_intervention.py
exclude tests/test_recruitment_sensitivity.py
exclude tests/test_import_order.py
exclude tests/test_fiberscope_geometry_cache.py
exclude tests/test_fiberscope_reporting.py
exclude tests/test_repository_app_compatibility.py
